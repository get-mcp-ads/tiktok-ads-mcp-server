# ─────────────────────────────────────────────────────────────────────────────
# tiktok-ads-mcp-server configuration
# TIKTOK_ACCESS_TOKEN and TIKTOK_APP_ID are required. TIKTOK_ADVERTISER_IDS is
# recommended and becomes required in 3.0.0. The rest is optional.
# ─────────────────────────────────────────────────────────────────────────────

# Long-lived access token from your TikTok for Business developer app.
# See the "Getting a token" section of the README.
TIKTOK_ACCESS_TOKEN=

# The App ID of that same developer app. TikTok ties the token to the app,
# so both are needed.
TIKTOK_APP_ID=

# Recommended. Comma-separated advertiser IDs this server may access, for reads
# and writes. When set, any other advertiser is refused before a request is
# sent, and account discovery only returns these. When unset, every advertiser
# the token reaches is accessible and the server says so on stderr at startup.
# Required from 3.0.0.
TIKTOK_ADVERTISER_IDS=

# Optional. Only needed if you call endpoints that require app authentication.
# TIKTOK_APP_SECRET=

# Optional. Saves passing advertiserId on every call. When
# TIKTOK_ADVERTISER_IDS is set, it must be one of them.
# TIKTOK_ADVERTISER_ID=

# Optional. Business Center ID, for Business Center scoped reads.
# TIKTOK_BUSINESS_CENTER_ID is read as an alias when this is unset.
# TIKTOK_BC_ID=

# Write tools are OFF by default. true registers the 30 write tools. The
# older spellings 1, yes and on still work with a deprecation notice on
# stderr; from 3.0.0 only true will. Writes need campaign management scopes,
# not just read scopes. Every write still previews first and applies only on a
# second call
# with confirm: true.
# TIKTOK_ENABLE_WRITES=true

# debug | info | warn | error
# LOG_LEVEL=info

# API environment: production or sandbox. Sandbox binds every call to one
# advertiser: the single ID in TIKTOK_ADVERTISER_IDS, or TIKTOK_ADVERTISER_ID.
TIKTOK_ENVIRONMENT=production
